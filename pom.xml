<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.worldadvancedtechnology</groupId>
    <artifactId>app-wat</artifactId>
    <version>3.0.0</version>
    <name>WORLD ADVANCED TECHNOLOGY Website</name>
    <description>Premium company web app for World Advanced Technology — IT Consultancy, DevOps and VoIP Solutions, Yaoundé, Cameroon</description>

    <properties>
        <java.version>17</java.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
        <!-- Override Spring Boot's managed Lombok (1.18.34) with a build that supports
             newer JDKs (incl. JDK 25). Without this, Lombok's annotation processor
             silently fails on JDK 23+ and every @Getter/@Setter method goes missing
             ("cannot find symbol"). -->
        <lombok.version>1.18.48</lombok.version>

        <!-- Keep `mvn sonar:sonar` in step with sonar-project.properties.
             JS/TS/CSS AND HTML are excluded because SonarQube's JS/CSS sensor
             analyzes them (incl. CSS/JS embedded in HTML) with an embedded
             Node.js runtime, which the CI agent does not have on PATH
             ("Cannot run program 'node'"). Install Node on the agent (or set
             sonar.nodejs.executable) and drop the web-asset patterns to analyze
             the static frontend instead. -->
        <sonar.exclusions>target/**,**/generated-sources/**,**/*.js,**/*.ts,**/*.css,**/*.scss,**/*.html,**/*.htm,**/*.vue</sonar.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Embedded file-based database (persists under ${WAT_DATA_DIR}) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>app-wat</finalName>
        <plugins>
            <!-- Explicitly register Lombok as an annotation processor (pinned to our
                 overridden version). Required so Lombok runs reliably on newer JDKs
                 instead of being silently skipped. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JaCoCo — code coverage. 0.8.12 supports Java 21 bytecode.
                 prepare-agent instruments tests; report writes
                 target/site/jacoco/jacoco.xml (which Sonar picks up automatically). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-initialize</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SonarQube / SonarCloud analysis.  Run:  ./mvnw clean verify sonar:sonar
                 4.x requires the analysis step to run on JDK 17+ (fine on your JDK 21). -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

    <!-- Nexus repositories for `./mvnw deploy`. The <id>s must match <server> ids
         in your settings.xml (credentials). -->
    <distributionManagement>
        <repository>
            <id>app-wat-releases</id>
            <url>http://192.168.100.11:8081/repository/appwat-releases/</url>
        </repository>
        <snapshotRepository>
            <id>app-wat-snapshots</id>
            <url>http://192.168.100.11:8081/repository/appwat-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
